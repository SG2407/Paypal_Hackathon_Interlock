# IntentLock Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file with real credentials

# Database
DATABASE_URL="file:./dev.db"

# PayPal Sandbox Configuration
# Get these from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# OpenAI Configuration
# Get this from https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Application Configuration
APP_BASE_URL=http://localhost:3000
NODE_ENV=development

# Optional, explicitly enabled Sandbox-only cart-drift demonstration.
# Set both flags to true to show and enable the demo checkout action.
INTENTLOCK_DEMO_MODE=false
NEXT_PUBLIC_INTENTLOCK_DEMO_MODE=false
